# Copy to .env and fill in.

# --- LLM (OpenRouter) ---
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-7b-instruct
QWEN_PREMIUM_MODEL=qwen/qwen3-next-80b-a3b-instruct

# --- Vector DB (Qdrant Cloud) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=candidates
# Must match the embedding provider's output dimension. Keep 384 for local ONNX.
QDRANT_VECTOR_SIZE=384

# --- Postgres / Storage (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=

# --- Queue / Cache / Rate limiting (BullMQ + ioredis) ---
REDIS_URL=

# --- Embeddings ---
# Leave EMBEDDING_API_URL/KEY empty to use the local ONNX model
# (Xenova/all-MiniLM-L6-v2, 384-d) — no network calls, no extra account.
#
# Or point at any OpenAI-compatible embeddings endpoint (e.g. Jina, OpenAI):
# EMBEDDING_API_URL=https://api.jina.ai/v1
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=jina-embeddings-v3
# EMBEDDING_VECTOR_SIZE=1024   # MUST match QDRANT_VECTOR_SIZE + re-embed collection
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Rate limiting ---
RATE_LIMIT_MAX=120