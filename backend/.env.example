# HireStack backend — copy to .env and fill in. Never commit .env.
# Required names are validated in backend/src/config/index.ts.

# --- Core ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CLERK_SECRET_KEY=

# --- Rate limiting (per IP, 60s window; middleware/rateLimit.ts) ---
# Both are no-ops when Redis is unreachable.
# RATE_LIMIT_LLM_MAX applies to /api/jd/, /api/candidates/search,
# /api/candidates/compare — the expensive LLM paths.
RATE_LIMIT_MAX=60
RATE_LIMIT_LLM_MAX=15

# --- Data / infra ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=candidates

# --- LLM ---
# QWEN_API_KEY expects an OPENROUTER key (config hardcodes
# baseUrl https://openrouter.ai/api/v1) — not a DashScope/Qwen key.
# Get one at https://openrouter.ai/keys
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-7b-instruct
QWEN_PREMIUM_MODEL=qwen/qwen3-next-80b-a3b-instruct

# --- Email (Resend, existing — untouched) ---
# Optional. When unset, interview invites and assessment invites are queued
# but never delivered; nothing else breaks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Gmail integration (Google Cloud Console) ---
# Create OAuth client (Web application) and paste values here.
# GOOGLE_REDIRECT_URI must EXACTLY match an Authorized redirect URI in
# Google Cloud Console → APIs & Services → Credentials → your OAuth client.
# Google rejects the token exchange on any mismatch, so pick ONE and register it:
#   via the Next.js proxy — http://localhost:3000/api/integrations/gmail/callback
#     (frontend/next.config.ts rewrites /api/* to the backend; requires the
#      frontend dev server to be running)
#   direct to the backend — http://localhost:8080/api/integrations/gmail/callback
#     (matches PORT=8080 in .env; 5000 is only the config default when PORT is unset)
#   production — https://<backend-host>/api/integrations/gmail/callback
# When unset, isGmailConfigured() is false and the Gmail connect flow is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# --- Gmail token encryption (AES-256-GCM, required for gmail_connections) ---
# Generate with: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=

# --- Embeddings (optional) ---
# EMBEDDING_API_KEY is only used when EMBEDDING_PROVIDER=hosted. With the
# default (local) no key is needed and hosted failures fall back to local.
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models
EMBEDDING_API_KEY=
EMBEDDING_HOSTED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LiveKit video/audio for technical interviews (optional, video layer only) ---
# When unset, interviews fall back to the external meeting_link and the
# token endpoints report videoEnabled:false. Secrets never leave the server.
# Get these from your LiveKit Cloud project (or self-hosted LiveKit server).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Code execution (Judge0, optional) ---
# When unset, CodeExecutionService uses a clearly-marked mock provider.
# Mock output is NEVER trusted for real scoring (submit is blocked).
# No key is ever sent to the browser.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_MS=10000
