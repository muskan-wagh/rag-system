# HireStack backend — copy to .env and fill in. Never commit .env.
# Required names are validated in backend/src/config/index.ts.

# --- Core ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CLERK_SECRET_KEY=

# --- Data / infra ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=candidates

# --- LLM ---
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen-2.5-7b-instruct
QWEN_PREMIUM_MODEL=qwen/qwen3-next-80b-a3b-instruct

# --- Email (Resend, existing — untouched) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Gmail integration (Google Cloud Console) ---
# Create OAuth client (Web application) and paste values here.
# Dev redirect:  http://localhost:5000/api/integrations/gmail/callback
# Prod redirect: https://<your-backend>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# --- Gmail token encryption (AES-256-GCM, required for gmail_connections) ---
# Generate with: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=

# --- Embeddings (optional) ---
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models
EMBEDDING_API_KEY=
EMBEDDING_HOSTED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Code execution (Judge0, optional) ---
# When unset, CodeExecutionService uses a clearly-marked mock provider.
# Mock output is NEVER trusted for real scoring (submit is blocked).
# No key is ever sent to the browser.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_MS=10000
